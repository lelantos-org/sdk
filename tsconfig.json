{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // `ESNext.Disposable` is types-only: it declares `Symbol.dispose` /
    // `Symbol.asyncDispose` so the aliases on `Wallet`, `WorkerRpc` and friends
    // typecheck. It emits nothing. It also declares `DisposableStack`, which is
    // a much newer runtime global — do not reach for that one here.
    "lib": ["ES2023", "DOM", "ESNext.Disposable"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.bench.ts",
    "src/**/*test-utils*"
  ]
}
