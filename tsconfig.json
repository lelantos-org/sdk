{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    // `ESNext.Disposable` is types-only and emits nothing: it declares
    // `Symbol.dispose` / `Symbol.asyncDispose` so the dispose aliases on
    // `WorkerRpc` and similar classes typecheck. It also declares
    // `DisposableStack`, a newer runtime global that must not be used here.
    "lib": ["ES2023", "DOM", "ESNext.Disposable"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  // Test material is excluded: the build emits only shipped modules.
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test-d.ts",
    "src/**/*.bench.ts",
    "src/test-utils"
  ]
}
