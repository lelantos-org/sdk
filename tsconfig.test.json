{
  // Type-checks what the build config excludes (tests, benches, test utils)
  // and `scripts/`. `tsconfig.json` drives emit and stays narrow; with this
  // config a moved module fails the `typecheck` gate instead of a vitest run.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The build config pins `rootDir` to `src` for emit layout. Nothing is
    // emitted here and `scripts/**` sits outside `src`, so the root widens to
    // the package; otherwise every script raises TS6059.
    "rootDir": ".",
    // Inherited from the build config; with `noEmit` they only produce
    // TS4023 noise about vitest's internal types being unnameable.
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
