{
  // Type-checks everything the build config excludes: tests, benches, and
  // test utils. `tsconfig.json` drives emit and must stay narrow; this one
  // exists purely so a moved module breaks the fast `typecheck` gate rather
  // than surfacing 90 seconds later as a runtime failure in vitest.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Inherited from the build config; with `noEmit` they only produce
    // TS4023 noise about vitest's internal types being unnameable.
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
