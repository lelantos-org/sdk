set shell := ["bash", "-ceuo", "pipefail"]

# WASM crates consumed by @lelantos-org/sdk. Each crate's wasm-pack output lands
# in its own `pkg/` (gitignored). SDK imports the generated JS/.d.ts via
# relative paths from `sdk/src/**`.
#
# Release builds need `wasm-opt` (binaryen) on PATH — both crates set their
# optimiser flags in `Cargo.toml` under `package.metadata.wasm-pack`. wasm-pack
# falls back to downloading a pinned binaryen when it cannot find one, which is
# slow and fails outright on some networks, so install it up front:
# `brew install binaryen` / `apt-get install binaryen`. `build-dev` skips it.

PROVER := "prover"
JUBJUB := "jubjub"

default:
    @just --list

# Build all WASM crates (release).
build: prover-build jubjub-build

# Faster dev build (no wasm-opt).
build-dev: prover-build-dev jubjub-build-dev

# One wasm-pack invocation. `wasm-pack` writes a `pkg/.gitignore` that would
# hide the build output from `npm pack`, so every build drops it.
[private]
wasm-build crate profile *cargo-flags:
    ( command -v wasm-pack >/dev/null || cargo install wasm-pack )
    cd {{crate}} && wasm-pack build --target web --{{profile}} --out-dir pkg {{cargo-flags}}
    rm -f {{crate}}/pkg/.gitignore

prover-build: (wasm-build PROVER "release")

prover-build-dev: (wasm-build PROVER "dev")

# Timing build: logs the witness-map/MSM split per proof. Slower; overwrites pkg/.
prover-build-trace: (wasm-build PROVER "release" "--" "--features" "trace")

jubjub-build: (wasm-build JUBJUB "release")

jubjub-build-dev: (wasm-build JUBJUB "dev")

check:
    cargo check --workspace --release --target wasm32-unknown-unknown

clippy:
    cargo clippy --workspace --release --target wasm32-unknown-unknown --all-features -- -D warnings

fmt:
    cargo fmt --all

fmt-check:
    cargo fmt --all --check

clean:
    cargo clean
    rm -rf {{PROVER}}/pkg {{JUBJUB}}/pkg

size: build
    @ls -lh {{PROVER}}/pkg/*_bg.wasm {{JUBJUB}}/pkg/*_bg.wasm | awk '{print $5, $9}'

# Run wasm benchmarks via Node. Builds first if pkg/ stale.
# Set PROVER_DIR=/path/to/2x2 to also bench prover (zkey + wtns).
bench:
    @[ -f {{JUBJUB}}/pkg/jubjub_wasm.js ] || just jubjub-build
    @[ -f {{PROVER}}/pkg/prover.js ] || just prover-build
    cd .. && node scripts/bench-wasm.mjs
