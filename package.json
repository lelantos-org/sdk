{
  "name": "@lelantos-org/sdk",
  "version": "0.1.0",
  "description": "Lelantos MASP client SDK — keys, notes, FMD, prover.",
  "license": "Apache-2.0",
  "author": "Lelantos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lelantos-org/sdk.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "default": "./dist/crypto/index.js"
    },
    "./wasm/prover": {
      "types": "./wasm/prover/pkg/prover.d.ts",
      "default": "./wasm/prover/pkg/prover.js"
    },
    "./wasm/prover/wasm": "./wasm/prover/pkg/prover_bg.wasm",
    "./wasm/jubjub": {
      "types": "./wasm/jubjub/pkg/jubjub_wasm.d.ts",
      "default": "./wasm/jubjub/pkg/jubjub_wasm.js"
    },
    "./wasm/jubjub/wasm": "./wasm/jubjub/pkg/jubjub_wasm_bg.wasm"
  },
  "files": [
    "dist",
    "wasm/prover/pkg",
    "wasm/jubjub/pkg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:vectors": "tsx scripts/gen-fmd-vectors.ts",
    "bench:scan": "tsx scripts/bench-scan.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/hashes": "^1.5.0",
    "@scure/bip39": "^1.3.0",
    "bech32": "^2.0.0",
    "circomlibjs": "^0.1.7",
    "ethers": "^6.13.0",
    "snarkjs": "^0.7.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "vitest": "^2.1.0"
  }
}
