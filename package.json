{
    "name": "@lelantos-org/sdk",
    "version": "0.39.0",
    "description": "Lelantos MASP client SDK — keys, notes, FMD, prover.",
    "license": "MIT",
    "author": "Lelantos",
    "type": "module",
    "sideEffects": [
        "./dist/prover/worker-entry.js",
        "./dist/sync/worker/entry.js",
        "./dist/runtime/wasm/rayon/bootstrap.mjs"
    ],
    "packageManager": "npm@10.9.2",
    "engines": {
        "node": ">=24.0.0"
    },
    "imports": {
        "#wasm/jubjub": "./wasm/jubjub/pkg/jubjub_wasm.js",
        "#wasm/prover": "./wasm/prover/pkg/prover.js",
        "#wasm/poseidon": "./wasm/poseidon/pkg/poseidon_wasm.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lelantos-org/sdk.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "main": "./dist/entry/index.js",
    "types": "./dist/entry/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/entry/index.d.ts",
            "default": "./dist/entry/index.js"
        },
        "./package.json": "./package.json",
        "./watch": {
            "types": "./dist/entry/watch.d.ts",
            "default": "./dist/entry/watch.js"
        },
        "./x402": {
            "types": "./dist/entry/x402.d.ts",
            "default": "./dist/entry/x402.js"
        },
        "./advanced": {
            "types": "./dist/entry/advanced.d.ts",
            "default": "./dist/entry/advanced.js"
        },
        "./prover": {
            "types": "./dist/entry/prover.d.ts",
            "default": "./dist/entry/prover.js"
        },
        "./protocol": {
            "types": "./dist/entry/protocol.d.ts",
            "default": "./dist/entry/protocol.js"
        },
        "./primitives": {
            "types": "./dist/entry/primitives.d.ts",
            "default": "./dist/entry/primitives.js"
        },
        "./services": {
            "types": "./dist/entry/services.d.ts",
            "default": "./dist/entry/services.js"
        },
        "./workers/prover": {
            "types": "./dist/prover/worker-entry.d.ts",
            "default": "./dist/prover/worker-entry.js"
        },
        "./workers/scanner": {
            "types": "./dist/sync/worker/entry.d.ts",
            "default": "./dist/sync/worker/entry.js"
        },
        "./internal": {
            "types": "./dist/entry/internal.d.ts",
            "default": "./dist/entry/internal.js"
        },
        "./wasm/prover": {
            "types": "./wasm/prover/pkg/prover.d.ts",
            "default": "./wasm/prover/pkg/prover.js"
        },
        "./wasm/prover/wasm": "./wasm/prover/pkg/prover_bg.wasm",
        "./wasm/jubjub": {
            "types": "./wasm/jubjub/pkg/jubjub_wasm.d.ts",
            "default": "./wasm/jubjub/pkg/jubjub_wasm.js"
        },
        "./wasm/jubjub/wasm": "./wasm/jubjub/pkg/jubjub_wasm_bg.wasm",
        "./wasm/poseidon": {
            "types": "./wasm/poseidon/pkg/poseidon_wasm.d.ts",
            "default": "./wasm/poseidon/pkg/poseidon_wasm.js"
        },
        "./wasm/poseidon/wasm": "./wasm/poseidon/pkg/poseidon_wasm_bg.wasm"
    },
    "files": [
        "CHANGELOG.md",
        "dist",
        "wasm/prover/pkg",
        "wasm/jubjub/pkg",
        "wasm/poseidon/pkg"
    ],
    "scripts": {
        "build": "node scripts/sync-version.mjs && rm -rf dist && tsc -p tsconfig.json --removeComments --declaration false --declarationMap false && tsc -p tsconfig.json --emitDeclarationOnly && mkdir -p dist/runtime/wasm/rayon && cp src/runtime/wasm/rayon/bootstrap.mjs dist/runtime/wasm/rayon/bootstrap.mjs",
        "typecheck": "node scripts/sync-version.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:bench": "vitest run --config vitest.bench.config.ts",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "check": "biome check . && node scripts/check-throws.mjs && node scripts/check-layers.mjs && node scripts/check-browser-safe.mjs && node scripts/check-wasm-imports.mjs && node scripts/check-entropy.mjs",
        "check:dist": "node scripts/bundle-budget.mjs && node scripts/check-public-api.mjs && npm run check:publish && node scripts/check-pack.mjs",
        "check:api": "node scripts/check-public-api.mjs",
        "check:publish": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./wasm/prover/wasm ./wasm/jubjub/wasm ./wasm/poseidon/wasm",
        "check:audit": "npm audit --omit=dev --audit-level=low && npm audit --audit-level=high",
        "check:audit:wasm": "cd wasm && cargo audit",
        "gen:vectors": "tsx scripts/gen-fmd-vectors.ts",
        "bench:scan": "tsx scripts/bench-scan.ts",
        "prepare": "lefthook install >/dev/null 2>&1 || true",
        "prepublishOnly": "cd wasm && just build && cd .. && npm run build && npm run check:dist && node scripts/check-wasm-size.mjs"
    },
    "peerDependencies": {
        "@lelantos-org/circuits": "0.16.0",
        "circom_runtime": "^0.1.28",
        "snarkjs": "^0.7.4",
        "viem": "^2.49.3"
    },
    "peerDependenciesMeta": {
        "@lelantos-org/circuits": {
            "optional": true
        },
        "circom_runtime": {
            "optional": true
        },
        "snarkjs": {
            "optional": true
        }
    },
    "dependencies": {
        "@noble/ciphers": "^1.0.0",
        "@noble/hashes": "^1.5.0",
        "@scure/bip39": "^1.3.0",
        "bech32": "^2.0.0",
        "poseidon-lite": "^0.3.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.17.0",
        "@biomejs/biome": "^2.4.13",
        "@lelantos-org/circuits": "0.16.0",
        "@lelantos-org/contracts": "0.10.0",
        "@types/node": "^24.0.0",
        "@vitest/coverage-v8": "^4.1.5",
        "circom_runtime": "^0.1.28",
        "esbuild": "^0.28.2",
        "fast-check": "^4.9.0",
        "lefthook": "^1.8.0",
        "publint": "^0.3.0",
        "snarkjs": "^0.7.4",
        "tsx": "^4.19.0",
        "typescript": "^5.7.2",
        "viem": "^2.49.3",
        "vitest": "^4.1.5"
    },
    "overrides": {
        "underscore": "^1.13.8"
    }
}
